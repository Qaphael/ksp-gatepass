# KSP GatePass environment variables.
# Copy this file to `.env` and adjust the values for your environment.
# Never commit real secrets.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by the app, Prisma CLI and migrations.
# Local development uses the embedded PostgreSQL started by `pnpm db:up`
# (default: postgres:postgres@localhost:5434/ksp_gatepass).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ksp_gatepass"

# --- Embedded database (development only) -----------------------------------
# Port used by `pnpm db:up` and the integration-test database.
EMBEDDED_PG_PORT=5434
# Name of the database created inside the embedded cluster.
EMBEDDED_PG_DATABASE="ksp_gatepass"

# --- Sessions ----------------------------------------------------------------
# Lifetime of a server session in hours. Sessions are stored hashed in the
# database; signing secrets are not used.
SESSION_TTL_HOURS=72
# Set to "true" when serving over HTTPS (defaults to true in production).
COOKIE_SECURE="true"
# Database name used by docker-compose.yml for the PostgreSQL service.
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ksp_gatepass"

# --- Login rate limiting -----------------------------------------------------
# Maximum failed login attempts per account+IP within the window before a
# temporary lockout (HTTP 429).
LOGIN_RATE_LIMIT_MAX=5
# Length of the rate-limit window in minutes.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Length of the temporary lockout in minutes after the limit is exceeded.
LOGIN_LOCKOUT_MINUTES=15
