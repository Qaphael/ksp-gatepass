# KSP GatePass environment variables.
# Copy this file to `.env` and adjust the values for your environment.
# Never commit real secrets.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by the app, Prisma CLI and migrations.
# Local development uses the embedded PostgreSQL started by `pnpm db:up`
# (default: postgres:postgres@localhost:5434/ksp_gatepass).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ksp_gatepass"

# --- Embedded database (development only) -----------------------------------
# Port used by `pnpm db:up` and the integration-test database.
EMBEDDED_PG_PORT=5434
# Name of the database created inside the embedded cluster.
EMBEDDED_PG_DATABASE="ksp_gatepass"

# --- Sessions ----------------------------------------------------------------
# Lifetime of a server session in hours. Sessions are stored hashed in the
# database; signing secrets are not used.
SESSION_TTL_HOURS=72
# Set to "true" when serving over HTTPS (defaults to true in production).
COOKIE_SECURE="true"
# Database name used by docker-compose.yml for the PostgreSQL service.
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ksp_gatepass"
# Host port for local-only app access. The production Caddy profile uses the
# internal app:3000 address and publishes only ports 80/443.
APP_PORT=3000
# Required by docker-compose.https.yml. Point DNS at this host and allow inbound 80/443.
GATEPASS_DOMAIN="gatepass.example.com"
# Host-side backup script destination. Set this only in the backup process
# environment to a protected path outside the checkout, database host volume,
# and ideally on separately managed storage.
# BACKUP_DIR="/mnt/ksp-gatepass-backups"

# --- QR token encryption -----------------------------------------------------
# AES-256-GCM key protecting the QR tokens stored at rest (base64url, 43 chars).
# Verification always uses the stored SHA-256 hash; this key is only used to
# recover a token when reprinting the identical QR code (business rule 8).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never commit a real key. The app refuses to start without it.
TOKEN_ENCRYPTION_KEY="replace-me-with-43-char-base64url-32-byte-key"

# Optional local image storage path; must be outside `public/`.
# Docker Compose uses its persistent event_branding volume at
# /var/lib/ksp-gatepass/branding instead.
# BRANDING_STORAGE_DIR="./.data/event-branding"

# --- Login rate limiting -----------------------------------------------------
# Maximum failed login attempts per account+IP within the window before a
# temporary lockout (HTTP 429).
LOGIN_RATE_LIMIT_MAX=5
# Length of the rate-limit window in minutes.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Length of the temporary lockout in minutes after the limit is exceeded.
LOGIN_LOCKOUT_MINUTES=15
