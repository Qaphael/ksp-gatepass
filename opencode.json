{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/business-rules.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "rm -rf*": "ask",
      "*prisma migrate reset*": "ask",
      "*prisma db push*": "ask",
      "*--force-reset*": "deny",
      "*DROP DATABASE*": "deny",
      "*DROP TABLE*": "ask"
    }
  }
}
