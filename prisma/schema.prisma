// KSP GatePass — Phase 1+2 core schema.
// Money is integer UGX. Sale/payment/check-in models arrive in later phases.
// DB-level CHECK constraints (non-negative prices, positive capacity, window
// ordering) are added in the migration SQL — Prisma 7 cannot express them in
// the schema file yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  VERIFIER
  SUPERVISOR
}

enum EventStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  ARCHIVED
}

// Admission policy stays configurable per event. FULL_PAYMENT is the default
// and only supported policy until explicitly extended.
enum AdmissionPolicy {
  FULL_PAYMENT
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
}

// Ticket INVENTORY state only (PRD 7.1). Sale state and admission state are
// separate concepts and live in later-phase models.
enum TicketStatus {
  AVAILABLE
  RESERVED
  SOLD
  CANCELLED
  REVOKED
}

// Every PDF/CSV output is traceable (PRD 5.6 rule 6).
enum PrintKind {
  SAMPLE
  PRODUCTION
  REPRINT
  EXPORT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id           String   @id @default(cuid())
  displayName  String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
}

model Session {
  id         String    @id @default(cuid())
  // SHA-256 of the opaque session token; the raw token exists only in the cookie.
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Durable rate-limit/lockout counter keyed by "acct:<username>" or "ip:<addr>".
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Event {
  id                String          @id @default(cuid())
  name              String
  description       String?
  venue             String
  address           String?
  timezone          String          @default("Africa/Kampala")
  // Calendar date of the event; wall-clock times are local to `timezone`.
  eventDate         DateTime        @db.Date
  startTime         String
  endTime           String
  capacity          Int
  // Absolute instants (UTC) for sales/admission windows; null = not set.
  salesOpensAt      DateTime?
  salesClosesAt     DateTime?
  admissionOpensAt  DateTime?
  admissionClosesAt DateTime?
  // Result of the open/close actions; windows alone do not open sales.
  salesOpen         Boolean         @default(false)
  admissionOpen     Boolean         @default(false)
  status            EventStatus     @default(DRAFT)
  admissionPolicy   AdmissionPolicy @default(FULL_PAYMENT)
  accentColor       String?
  ticketFooterText  String?
  organiserContact  String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  ticketTypes    TicketType[]
  auditLogs      AuditLog[]
  tickets        Ticket[]
  ticketBatches  TicketBatch[]
  printBatches   PrintBatch[]

  @@index([status])
}

model TicketType {
  id               String           @id @default(cuid())
  eventId          String
  name             String
  description      String?
  // Integer UGX. A sold ticket snapshots its price at sale time (later phases).
  priceUgx         Int
  // Null = bounded only by remaining event capacity.
  allocationLimit  Int?
  salesOpensAt     DateTime?
  salesClosesAt    DateTime?
  permitsAdmission Boolean          @default(true)
  status           TicketTypeStatus @default(ACTIVE)
  printLabel       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, name])
  @@index([eventId])

  tickets       Ticket[]
  ticketBatches TicketBatch[]
}

// A generation run: unique serial range + secure QR tokens for `quantity`
// tickets, committed atomically. `idempotencyKey` makes retries safe (rule 8).
model TicketBatch {
  id             String   @id @default(cuid())
  // Human traceable reference, e.g. "BATCH-K7Q2X9".
  batchRef       String   @unique
  eventId        String
  ticketTypeId   String
  quantity       Int
  serialPrefix   String
  serialStart    Int
  serialEnd      Int
  label          String?
  idempotencyKey String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  tickets      Ticket[]
  printBatches PrintBatch[]

  @@index([eventId, createdAt])
  @@index([ticketTypeId])
}

// One generated ticket. `serial` and `tokenHash` are globally unique (PRD 7.5
// rules 2-3). The raw QR token exists in two forms: `tokenHash` (SHA-256,
// used for every verification lookup) and `tokenEnc` (AES-256-GCM under
// TOKEN_ENCRYPTION_KEY, decrypted ONLY inside the print path so reprints can
// reproduce the identical QR — business rule 8). Neither column is ever
// returned by list/detail APIs, exports, logs or audit records.
model Ticket {
  id           String       @id @default(cuid())
  eventId      String
  ticketTypeId String
  batchId      String?
  serial       String       @unique
  tokenHash    String       @unique
  tokenEnc     String
  status       TicketStatus @default(AVAILABLE)
  // Set when status becomes REVOKED; reasons are mandatory at the API layer.
  revokeReason String?
  revokedById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  batch      TicketBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  printBatches PrintBatch[]

  @@index([eventId, status])
  @@index([ticketTypeId, status])
  @@index([batchId])
  @@index([serial])
}

// Traceability of every printed or exported output (PRD 5.6 rules 6-8).
model PrintBatch {
  id            String    @id @default(cuid())
  kind          PrintKind
  eventId       String
  // Set when a whole generation batch was printed/sampled.
  ticketBatchId String?
  // Set when a single ticket was reprinted.
  ticketId      String?
  ticketCount   Int
  metadata      Json?
  actorId       String?
  createdAt     DateTime  @default(now())

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketBatch TicketBatch? @relation(fields: [ticketBatchId], references: [id], onDelete: SetNull)
  ticket      Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([ticketBatchId])
  @@index([ticketId, createdAt])
}

// Append-only audit trail. Never store passwords, session tokens or raw QR
// tokens in `summary`.
model AuditLog {
  id         String        @id @default(cuid())
  actorId    String?
  actorRole  Role?
  // Stable dotted action code, e.g. "auth.login.success", "event.create".
  action     String
  targetType String?
  targetId   String?
  eventId    String?
  outcome    AuditOutcome  @default(SUCCESS)
  summary    Json?
  createdAt  DateTime      @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}
