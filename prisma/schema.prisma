// KSP GatePass — Phase 1+2 core schema.
// Money is integer UGX. Sale/payment/check-in models arrive in later phases.
// DB-level CHECK constraints (non-negative prices, positive capacity, window
// ordering) are added in the migration SQL — Prisma 7 cannot express them in
// the schema file yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  VERIFIER
  SUPERVISOR
}

enum EventStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  ARCHIVED
}

enum EventBrandingKind {
  POSTER
  LOGO
}

// Admission policy stays configurable per event. FULL_PAYMENT is the default
// and only supported policy until explicitly extended.
enum AdmissionPolicy {
  FULL_PAYMENT
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
}

// Ticket INVENTORY state only (PRD 7.1). Sale state and admission state are
// separate concepts and live in later-phase models.
enum TicketStatus {
  AVAILABLE
  RESERVED
  SOLD
  CANCELLED
  REVOKED
}

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  RECORDED
  REVERSED
  REFUNDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentAdjustmentType {
  REVERSAL
  REFUND
}

enum CheckInMethod {
  QR
  MANUAL
}

enum ScanMethod {
  QR
  SERIAL
}

enum ScanResultCode {
  ELIGIBLE
  ADMITTED
  INVALID_QR
  UNKNOWN_SERIAL
  OTHER_EVENT
  NOT_PAID
  TICKET_CANCELLED
  TICKET_REVOKED
  ALREADY_USED
  NOT_YET_VALID
  EXPIRED
  ADMISSION_CLOSED
  TICKET_NOT_SOLD
  CATEGORY_NOT_ADMISSIBLE
}

// Every PDF/CSV output is traceable (PRD 5.6 rule 6).
enum PrintKind {
  SAMPLE
  PRODUCTION
  REPRINT
  EXPORT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id           String   @id @default(cuid())
  displayName  String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  sales    Sale[]
  paymentsRecorded Payment[]
  paymentAdjustmentsRecorded PaymentAdjustment[]
  checkIns CheckIn[]
  scanAttempts ScanAttempt[]
  checkInCorrections CheckInCorrection[]
}

model Session {
  id         String    @id @default(cuid())
  // SHA-256 of the opaque session token; the raw token exists only in the cookie.
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Durable rate-limit/lockout counter keyed by "acct:<username>" or "ip:<addr>".
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Event {
  id                String          @id @default(cuid())
  name              String
  description       String?
  venue             String
  address           String?
  timezone          String          @default("Africa/Kampala")
  // Calendar date of the event; wall-clock times are local to `timezone`.
  eventDate         DateTime        @db.Date
  startTime         String
  endTime           String
  capacity          Int
  // Absolute instants (UTC) for sales/admission windows; null = not set.
  salesOpensAt      DateTime?
  salesClosesAt     DateTime?
  admissionOpensAt  DateTime?
  admissionClosesAt DateTime?
  // Result of the open/close actions; windows alone do not open sales.
  salesOpen         Boolean         @default(false)
  admissionOpen     Boolean         @default(false)
  // Irreversible marker: ordinary sale cancellation/refund stops once admission has ever opened.
  admissionStartedAt DateTime?
  status            EventStatus     @default(DRAFT)
  admissionPolicy   AdmissionPolicy @default(FULL_PAYMENT)
  accentColor       String?
  ticketFooterText  String?
  organiserContact  String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  ticketTypes    TicketType[]
  auditLogs      AuditLog[]
  tickets        Ticket[]
  ticketBatches  TicketBatch[]
  printBatches   PrintBatch[]
  sales          Sale[]
  checkIns       CheckIn[]
  scanAttempts   ScanAttempt[]
  brandingAssets EventBrandingAsset[]

  @@index([status])
}

model EventBrandingAsset {
  id            String            @id @default(cuid())
  eventId       String
  kind          EventBrandingKind
  storageKey    String            @unique
  thumbnailKey  String            @unique
  displayKey    String            @unique
  altText       String
  width         Int
  height        Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
  @@index([eventId])
}

model TicketType {
  id               String           @id @default(cuid())
  eventId          String
  name             String
  description      String?
  // Integer UGX. A sold ticket snapshots its price at sale time (later phases).
  priceUgx         Int
  // Null = bounded only by remaining event capacity.
  allocationLimit  Int?
  salesOpensAt     DateTime?
  salesClosesAt    DateTime?
  permitsAdmission Boolean          @default(true)
  status           TicketTypeStatus @default(ACTIVE)
  printLabel       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, name])
  @@index([eventId])

  tickets       Ticket[]
  ticketBatches TicketBatch[]
  saleItems     SaleItem[]
}

// A generation run: unique serial range + secure QR tokens for `quantity`
// tickets, committed atomically. `idempotencyKey` makes retries safe (rule 8).
model TicketBatch {
  id             String   @id @default(cuid())
  // Human traceable reference, e.g. "BATCH-K7Q2X9".
  batchRef       String   @unique
  eventId        String
  ticketTypeId   String
  quantity       Int
  serialPrefix   String
  serialStart    Int
  serialEnd      Int
  label          String?
  idempotencyKey String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  tickets      Ticket[]
  printBatches PrintBatch[]

  @@index([eventId, createdAt])
  @@index([ticketTypeId])
}

// One generated ticket. `serial` and `tokenHash` are globally unique (PRD 7.5
// rules 2-3). The raw QR token exists in two forms: `tokenHash` (SHA-256,
// used for every verification lookup) and `tokenEnc` (AES-256-GCM under
// TOKEN_ENCRYPTION_KEY, decrypted ONLY inside the print path so reprints can
// reproduce the identical QR — business rule 8). Neither column is ever
// returned by list/detail APIs, exports, logs or audit records.
model Ticket {
  id           String       @id @default(cuid())
  eventId      String
  ticketTypeId String
  batchId      String?
  serial       String       @unique
  tokenHash    String       @unique
  tokenEnc     String
  status       TicketStatus @default(AVAILABLE)
  // Set when status becomes REVOKED; reasons are mandatory at the API layer.
  revokeReason String?
  revokedById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  batch      TicketBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  printBatches PrintBatch[]
  saleTickets  SaleTicket[]
  checkIn      CheckIn?
  scanAttempts ScanAttempt[]

  @@index([eventId, status])
  @@index([ticketTypeId, status])
  @@index([batchId])
  @@index([serial])
}

// Traceability of every printed or exported output (PRD 5.6 rules 6-8).
model PrintBatch {
  id            String    @id @default(cuid())
  kind          PrintKind
  eventId       String
  // Set when a whole generation batch was printed/sampled.
  ticketBatchId String?
  // Set when a single ticket was reprinted.
  ticketId      String?
  ticketCount   Int
  metadata      Json?
  actorId       String?
  createdAt     DateTime  @default(now())

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketBatch TicketBatch? @relation(fields: [ticketBatchId], references: [id], onDelete: SetNull)
  ticket      Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([ticketBatchId])
  @@index([ticketId, createdAt])
}

// Append-only audit trail. Never store passwords, session tokens or raw QR
// tokens in `summary`.
model AuditLog {
  id         String        @id @default(cuid())
  actorId    String?
  actorRole  Role?
  // Stable dotted action code, e.g. "auth.login.success", "event.create".
  action     String
  targetType String?
  targetId   String?
  eventId    String?
  outcome    AuditOutcome  @default(SUCCESS)
  summary    Json?
  createdAt  DateTime      @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

// Confirmed sales retain server-calculated totals and an immutable actor.
model Sale {
  id                String     @id @default(cuid())
  reference         String     @unique
  eventId           String
  sellerId          String
  customerName      String?
  customerPhone     String?
  customerReference String?
  notes             String?
  subtotalUgx       Int
  discountUgx       Int        @default(0)
  discountReason    String?
  discountedById    String?
  totalUgx          Int
  status            SaleStatus @default(PENDING_PAYMENT)
  idempotencyKey    String?
  requestHash       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items       SaleItem[]
  tickets     SaleTicket[]
  payments    Payment[]

  @@unique([sellerId, idempotencyKey])
  @@index([eventId, createdAt])
  @@index([sellerId, createdAt])
  @@index([eventId, status, createdAt])
}

model SaleItem {
  id            String @id @default(cuid())
  saleId        String
  ticketTypeId  String
  quantity      Int
  unitPriceUgx  Int
  discountUgx   Int    @default(0)
  lineTotalUgx  Int

  sale       Sale       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    SaleTicket[]

  @@unique([saleId, ticketTypeId])
  @@index([ticketTypeId])
}

// ticketId is unique: one ticket can be allocated to at most one sale ever.
model SaleTicket {
  id         String @id @default(cuid())
  saleId     String
  saleItemId String
  ticketId   String @unique

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([saleItemId])
}

// Payment rows are never updated/deleted by application workflows. Corrections
// are represented by linked PaymentAdjustment rows.
model Payment {
  id             String        @id @default(cuid())
  reference      String        @unique
  saleId         String
  amountUgx      Int
  method         PaymentMethod
  externalRef    String?
  notes          String?
  status         PaymentStatus @default(RECORDED)
  recordedById   String
  idempotencyKey String?       @unique
  requestHash    String?
  recordedAt     DateTime      @default(now())

  sale        Sale               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  recordedBy  User               @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  adjustments PaymentAdjustment[]

  @@index([saleId, recordedAt])
}

model PaymentAdjustment {
  id             String               @id @default(cuid())
  paymentId      String
  type           PaymentAdjustmentType
  amountUgx      Int
  reason         String
  recordedById   String
  idempotencyKey String?              @unique
  requestHash    String?
  createdAt      DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  recordedBy User @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}

// Successful admissions are immutable; ticketId is the database duplicate guard.
model CheckIn {
  id             String       @id @default(cuid())
  eventId        String
  ticketId       String       @unique
  verifierId     String
  gate           String
  method         CheckInMethod
  checkedInAt    DateTime     @default(now())
  idempotencyKey String       @unique
  requestHash    String

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  verifier    User               @relation(fields: [verifierId], references: [id], onDelete: Restrict)
  corrections CheckInCorrection[]

  @@index([eventId, checkedInAt])
  @@index([verifierId, checkedInAt])
  @@index([eventId, gate, checkedInAt])
}

// Failed and successful verify/confirm outcomes; QR token material is never stored.
model ScanAttempt {
  id          String         @id @default(cuid())
  eventId     String
  actorId     String
  ticketId    String?
  method      ScanMethod
  resultCode  ScanResultCode
  gate        String?
  serial      String?
  attemptedAt DateTime       @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor  User    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([eventId, attemptedAt])
  @@index([actorId, attemptedAt])
  @@index([eventId, resultCode, attemptedAt])
  @@index([ticketId, attemptedAt])
}

// Incident corrections explain an existing check-in without editing or deleting it.
model CheckInCorrection {
  id                     String   @id @default(cuid())
  checkInId              String
  actorId                String
  confirmedTicketSerial  String
  reason                 String
  createdAt              DateTime @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([checkInId, createdAt])
  @@index([actorId, createdAt])
}
